FROM node:20-alpine

WORKDIR /app

COPY package*.json ./

# Install deps (local dev)
RUN npm install

# Install global dev tools
RUN npm install -g ts-node-dev prisma

# Copy everything AFTER deps
COPY . .

# Make entrypoint runnable
RUN chmod +x ./entrypoint.dev.sh

ENV NODE_ENV=development

CMD ["./entrypoint.dev.sh"]
