{
  "name": "accountant-pathfinder-backend",
  "version": "1.0.0",
  "description": "Backend API for the Pathfinder application, providing user authentication, profile management, and payment processing functionalities.",
  "main": "index.js",
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "dev:worker": " tsx watch src/workers/index.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/index.js",
    "build": "tsc --build && tsc-alias",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "migrate:deploy": "prisma migrate deploy",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "dev:docker:logs": "docker compose -f docker-compose.dev.yml logs -f pathfinder-api",
    "prod:docker": "docker compose -f docker-compose.yml up --build -d",
    "prod:docker:logs": "docker compose -f docker-compose.yml logs -f pathfinder-api"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "Godswill Udida",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@bull-board/api": "~8.1.2",
    "@bull-board/express": "~8.1.2",
    "@prisma/client": "6.19.1",
    "@types/multer": "^2.1.0",
    "@types/passport-google-oauth20": "~2.0.17",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "~5.79.1",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "connect-redis": "~9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "express-basic-auth": "~1.2.1",
    "express-rate-limit": "^8.3.2",
    "google-auth-library": "~10.6.2",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.5.0",
    "nodemailer": "~8.0.5",
    "passport": "~0.7.0",
    "passport-google-oauth20": "~2.0.0",
    "passport-google-oidc": "~0.1.0",
    "slugify": "^1.6.9",
    "source-map": "~0.7.6",
    "streamifier": "^0.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typescript": "~6.0.2",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "~3.1.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-google-oidc": "~0.1.0",
    "@types/streamifier": "^0.1.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "6.19.1",
    "tsc-alias": "^1.9.7",
    "tsconfig-paths": "^4.2.0",
    "tsx": "~4.21.0",
    "wait-port": "^1.1.0"
  }
}
