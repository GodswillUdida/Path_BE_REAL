generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * |--------------------------------------------------------------------------
 * | ARCHITECTURE NOTES
 * |--------------------------------------------------------------------------
 * |
 * | This application is a SINGLE ORGANIZATION / SINGLE EDUCATION BUSINESS.
 * |
 * | The domain hierarchy is:
 * |
 * |   Program
 * |      ↓
 * |   ProgramCourse
 * |      ↓
 * |   Course
 * |      ↓
 * |   Module
 * |      ↓
 * |   Topic
 * |      ↓
 * |   VideoAsset
 * |
 * | Commercial / access hierarchy:
 * |
 * |   Course
 * |      ↓
 * |   CoursePricing
 * |      ↓
 * |   Order
 * |      ↓
 * |   OrderItem
 * |      ↓
 * |   Enrollment
 * |
 * | Student / community hierarchy (added for the two-tier learner model):
 * |
 * |   User ──(0..1)── StudentProfile
 * |                        ↓
 * |                   CohortMember ──── Cohort
 * |                                       ├── CohortInstructor
 * |                                       ├── CohortCourse
 * |                                       ├── ChatRoom ── ChatMessage
 * |                                       ├── LiveSessionCohort ── LiveSession
 * |                                       └── AnnouncementTarget ── Announcement
 * |
 * | Core rules:
 * |
 * | 1. Program organizes courses. It is NOT the purchasable product.
 * | 2. Course is the purchasable learning product.
 * | 3. CoursePricing is the commercial offer/access plan.
 * | 4. Order/Payment represent commerce.
 * | 5. Enrollment represents CURRENT learner access.
 * | 6. Progress belongs to Enrollment.
 * | 7. VideoAsset is provider-independent.
 * | 8. Bunny is the default media provider, but AWS, Cloudflare and Mux
 * |    are first-class supported providers.
 * | 9. Topic.durationSeconds is the curriculum duration cache.
 * | 10. Module.totalDurationSeconds and Course.totalDurationSeconds are
 * |     denormalized aggregates maintained by the service layer.
 * |
 * | Learner tier rules (NEW):
 * |
 * | 11. TWO ORTHOGONAL AXES. Course access (Enrollment) and community
 * |     access (StudentProfile + CohortMember) are independent. A public
 * |     buyer has Enrollment only. A registered student has a
 * |     StudentProfile and usually Enrollments too.
 * | 12. Role.student means "learner account" (public OR registered).
 * |     It does NOT mean registered student. Registered student =
 * |     StudentProfile.status = ACTIVE. Guards must check the profile,
 * |     never the role enum.
 * | 13. StudentProfile is created ONLY by staff (manual, CSV import, or
 * |     approved Applicant). Never self-service, never as a purchase
 * |     side effect.
 * | 14. Community features (chat, live sessions, announcements) are
 * |     scoped to a Cohort. Authorization is ONE policy function:
 * |       admin/superadmin  -> any cohort
 * |       instructor        -> cohorts with a CohortInstructor row
 * |       student           -> ACTIVE StudentProfile + ACTIVE CohortMember
 * |     REST guards and the WebSocket layer MUST call the same policy.
 * | 15. Enrollment.source records how access was CREATED. Later renewals
 * |     and admin extensions mutate expiresAt and are recorded in
 * |     AdminAuditLog (action + before/after in metadata).
 * | 16. Notification is the per-user alert/inbox record. The announcement
 * |     FEED is computed from Announcement + AnnouncementTarget so late
 * |     joiners still see history. Notification only carries read state
 * |     and alerting.
 * | 17. Every fan-out write (notifications, reminders) is idempotent via
 * |     Notification (userId, dedupeKey). Retries must never duplicate.
 * | 18. Chat messages and notification rows are append-heavy. Always
 * |     cursor-paginate on (createdAt, id). Never OFFSET.
 * | 19. Webhook idempotency lives in PaymentEvent (gateway, eventId),
 * |     not on Payment. Every delivery is stored, signature-checked, and
 * |     marked processed or failed. Nothing is dropped silently.
 * | 20. Ordering columns (position) are not unique; reorder in one
 * |     transaction and read with (position, id). Soft-deleted rows must
 * |     suffix their slug so they never reserve it.
 * | 21. Secrets at rest are hashed (OTP codes, session tokens).
 * | 22. LIVE-CLASS SEATS. A seat is a CohortOffer sold through the normal
 * |     order flow. Paying creates CohortMember (live access, ends at
 * |     cohort end) and, if bundled, Enrollment source COHORT_SEAT for each
 * |     CohortCourse (content access, ends at cohort end + bonusDays).
 * | 23. Submitting the application form grants student STATUS only
 * |     (StudentProfile). It never grants course or live access.
 * | 24. bonusDays is snapshotted onto OrderItem at order creation;
 * |     fulfillment reads the snapshot. The bonus is baked into expiresAt.
 * | 25. Capacity: checked under a per-cohort advisory lock at order
 * |     creation (pending items = holds) and again at fulfillment. A paid
 * |     seat that finds the cohort full is an ANOMALY (refund/waitlist),
 * |     never silently dropped.
 * | 26. Chat rooms are cohort OR course scoped. Membership is always
 * |     derived (CohortMember / Enrollment), never stored in the room.
 * | 27. Live sessions are provider-agnostic: ZOOM / GOOGLE_MEET (external
 * |     link, licence-scheduled) now, LIVEKIT (in-app) later. Recordings
 * |     live on Bunny Stream as LiveSessionRecording.
 * |
 * | FUTURE:
 * | - If the business becomes multi-tenant, introduce Organization and
 * |   organization-scoped ownership. Do NOT add it speculatively now.
 * | - If the platform later needs true curriculum versioning, add a
 * |   published curriculum/version model instead of mutating historical
 * |   learning structures.
 * | - If the platform later needs multiple access grants per enrollment,
 * |   introduce EnrollmentAccessGrant. Do not add it until renewal/audit
 * |   requirements justify it. (Trigger: instalment plans, pause/resume,
 * |   or reporting that must list every individual extension.)
 * |
 * |--------------------------------------------------------------------------
 */

// ============================================================
// INTAKE / APPLICANT DOMAIN
// ============================================================

model Applicant {
  id String @id @default(uuid())

  fullName String
  email    String
  phone    String
  address  String

  lectureCenter  String?
  previousCenter String?

  isNewStudent Boolean @default(true)
  level        String?

  papers ApplicantPaper[]

  careerChallenges String?
  referredBy       String?

  employment EmploymentInfo?
  sponsor    SponsorInfo?

  documents String[] @default([])

  status ApplicantStatus @default(PENDING)

  /**
   * Set when staff convert an APPROVED applicant into a registered
   * student. One applicant -> at most one StudentProfile.
   */
  studentProfile StudentProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * The signed-in account that applied (no guest checkout). Null only on
   * legacy rows.
   */
  userId String?
  user   User?   @relation("ApplicantUser", fields: [userId], references: [id], onDelete: SetNull)

  /**
   * Batch offer picked from the backend-driven list on the form.
   */
  cohortOfferId String?
  cohortOffer   CohortOffer? @relation(fields: [cohortOfferId], references: [id], onDelete: SetNull)

  /**
   * Submitting the form auto-approves it and creates the StudentProfile
   * (student STATUS only; access still has to be paid for). Admins can
   * still decide manually.
   */
  approvedAt   DateTime?
  autoApproved Boolean   @default(false)

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([cohortOfferId])
}

model ApplicantPaper {
  id          String @id @default(uuid())
  applicantId String
  paperName   String

  /**
   * Selected from the backend course list. paperName stays as the display
   * snapshot (and for legacy free-text rows).
   */
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@index([courseId])
}

model EmploymentInfo {
  id          String @id @default(uuid())
  applicantId String @unique

  placeOfWork String?
  position    String?

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

model SponsorInfo {
  id          String @id @default(uuid())
  applicantId String @unique

  name      String?
  phone     String?
  email     String?
  location  String?
  workplace String?

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

enum ApplicantStatus {
  PENDING
  REVIEWED
  APPROVED
  REJECTED
}

// ============================================================
// IDENTITY / AUTH
// ============================================================

model User {
  id           String  @id @default(uuid())
  name         String?
  email        String  @unique
  profileImage String?
  phone        String?

  /**
   * Account type. NOT the registered-student flag.
   * See architecture rule 12.
   */
  role Role @default(student)

  emailVerified Boolean @default(false)

  verificationToken   String?   @unique
  verificationExpires DateTime?

  resetToken        String?   @unique
  resetTokenExpires DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  carts          Cart[]
  courses        Course[]        @relation("InstructorCourses")
  enrollments    Enrollment[]
  orders         Order[]
  payments       Payment[]
  accounts       Account[]
  sessions       Session[]
  adminAuditLogs AdminAuditLog[]

  // --- Student / community relations ---
  studentProfile       StudentProfile?      @relation("StudentUser")
  registeredStudents   StudentProfile[]     @relation("StudentRegisteredBy")
  studentImportBatches StudentImportBatch[] @relation("StudentImportUploader")
  grantedEnrollments   Enrollment[]         @relation("EnrollmentGrantedBy")
  createdCohorts       Cohort[]             @relation("CohortCreatedBy")
  cohortInstructorOf   CohortInstructor[]
  createdAnnouncements Announcement[]       @relation("AnnouncementCreatedBy")
  hostedLiveSessions   LiveSession[]        @relation("LiveSessionHost")
  notifications        Notification[]
  chatMessages         ChatMessage[]        @relation("ChatSender")
  deletedChatMessages  ChatMessage[]        @relation("ChatMessageDeletedBy")
  chatReadStates       ChatReadState[]

  applications Applicant[] @relation("ApplicantUser")

  @@index([deletedAt])
  @@map("users")
}

model AdminAuditLog {
  id String @id @default(uuid())

  adminId String
  admin   User   @relation(fields: [adminId], references: [id], onDelete: Restrict)

  /**
   * Examples (use a shared constants file, not free-typed strings):
   * STUDENT_REGISTERED, STUDENT_STATUS_CHANGED, COHORT_MEMBER_ADDED,
   * COHORT_MEMBER_REMOVED, ENROLLMENT_GRANTED, ENROLLMENT_EXTENDED,
   * ENROLLMENT_REVOKED, CHAT_MESSAGE_DELETED, CHAT_MEMBER_MUTED,
   * ANNOUNCEMENT_PUBLISHED, LIVE_SESSION_CANCELLED.
   * metadata MUST carry before/after values for extensions and status
   * changes (rule 15).
   */
  action     String
  targetType String
  targetId   String

  metadata Json?

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Account {
  id     String @id @default(uuid())
  userId String

  provider   String
  providerId String

  password String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("accounts")
}

model Otp {
  id String @id @default(uuid())

  email String

  /**
   * HASHED (SHA-256 or HMAC with a server secret), never the raw code.
   * Compare with a constant-time check. Raw OTPs must not exist at rest.
   */
  codeHash String

  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)

  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Session {
  id String @id @default(uuid())

  userId String

  tokenId     String  @unique
  tokenHash   String  @unique
  userAgent   String?
  ipAddress   String?
  fingerprint String?

  expiresAt DateTime
  revokedAt DateTime?

  provider String @default("credentials")

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model IdempotencyKey {
  id String @id @default(uuid())

  key   String
  scope String

  response   Json?
  statusCode Int?

  createdAt DateTime @default(now())

  /**
   * FUTURE:
   * Add expiresAt when you introduce scheduled cleanup of old
   * idempotency records. Do not rely on an application process reading
   * every historical key forever.
   */

  @@unique([key, scope])
  @@index([createdAt])
}

// ============================================================
// STUDENT DOMAIN  (PHASE 1)
// ============================================================

enum StudentStatus {
  ACTIVE
  SUSPENDED
  ALUMNI
  WITHDRAWN
}

enum StudentRegistrationSource {
  MANUAL
  CSV_IMPORT
  APPLICATION
}

/**
 * Registered-student marker + standing.
 * Exactly one per User at most. Created by staff only (rule 13).
 * ONLY status = ACTIVE unlocks community features. SUSPENDED, ALUMNI
 * and WITHDRAWN keep their purchased course access (Enrollment) but lose
 * chat, live sessions and the student announcement feed.
 */
model StudentProfile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation("StudentUser", fields: [userId], references: [id], onDelete: Restrict)

  /**
   * The client's own registration/student number, if he has one.
   * Nullable because it may not exist for every student.
   */
  studentCode String? @unique

  status          StudentStatus @default(ACTIVE)
  statusReason    String?
  statusChangedAt DateTime?

  registrationSource StudentRegistrationSource @default(MANUAL)

  registeredById String?
  registeredBy   User?    @relation("StudentRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  registeredAt   DateTime @default(now())

  applicantId String?    @unique
  applicant   Applicant? @relation(fields: [applicantId], references: [id], onDelete: SetNull)

  importBatchId String?
  importBatch   StudentImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohortMemberships CohortMember[]

  @@index([status])
  @@index([registeredAt])
  @@index([importBatchId])
}

enum ImportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

/**
 * Bulk CSV registration. Processed by a Bull worker; the admin UI polls
 * this row. Failed rows must be visible, never silently dropped.
 */
model StudentImportBatch {
  id String @id @default(uuid())

  uploadedById String
  uploadedBy   User   @relation("StudentImportUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  /**
   * Storage URL of the uploaded CSV (object storage, never local disk).
   */
  fileUrl String

  status ImportStatus @default(QUEUED)

  totalRows   Int @default(0)
  successRows Int @default(0)
  failedRows  Int @default(0)

  /**
   * Row-level failures: [{ row, email, code, message }].
   * Service caps this array (e.g. first 500); store the full report in
   * object storage if a larger report is ever needed.
   */
  errors Json?

  /**
   * Import parameters (e.g. target cohortId, sendInvite flag).
   */
  options Json?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  students StudentProfile[]

  @@index([status])
  @@index([createdAt])
  @@index([uploadedById])
}

// ============================================================
// COHORT DOMAIN  (PHASE 1)
// ============================================================

enum CohortStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

/**
 * A class / batch of students. The targeting and authorization unit for
 * chat, live sessions and announcements.
 */
model Cohort {
  id String @id @default(uuid())

  name        String
  slug        String  @unique
  description String?

  /**
   * Physical lecture centre. Free text on purpose, aligned with
   * Applicant.lectureCenter. Promote to a model only if centres gain
   * their own behaviour (address, staff, capacity).
   */
  centre String?

  status CohortStatus @default(UPCOMING)

  startsAt DateTime?
  endsAt   DateTime?

  /**
   * Max ACTIVE seats; null = unlimited. Enforced under a per-cohort lock at
   * order creation (pending order items count as holds) and again at
   * fulfillment.
   */
  capacity Int?

  createdById String
  createdBy   User   @relation("CohortCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  members             CohortMember[]
  instructors         CohortInstructor[]
  courses             CohortCourse[]
  chatRooms           ChatRoom[]
  liveSessions        LiveSessionCohort[]
  announcementTargets AnnouncementTarget[]

  offers          CohortOffer[]
  seatEnrollments Enrollment[]  @relation("CohortSeatEnrollments")

  @@index([status, deletedAt])
  @@index([centre])
  @@index([startsAt])
}

/**
 * Which courses a cohort studies. Drives the admin "grant course access
 * to the whole cohort" action. It does NOT itself grant access:
 * access is always an Enrollment row.
 */
model CohortCourse {
  id String @id @default(uuid())

  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([cohortId, courseId])
  @@index([courseId])
}

/**
 * Staff (Role.instructor) assigned to a cohort. Required so instructors
 * can access cohort chat/sessions without being students.
 */
model CohortInstructor {
  id String @id @default(uuid())

  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([cohortId, userId])
  @@index([userId])
}

enum CohortMemberSource {
  PURCHASE
  ADMIN
  IMPORT
}

enum CohortMemberStatus {
  ACTIVE
  REMOVED
  COMPLETED
}

/**
 * Keyed on userId, FK'd to StudentProfile.userId. This guarantees
 * "only registered students can be members" at the database level AND
 * keeps hot-path membership checks (every chat send) to a single
 * indexed lookup on (cohortId, userId) with no join.
 */
model CohortMember {
  id String @id @default(uuid())

  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  userId  String
  student StudentProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  status CohortMemberStatus @default(ACTIVE)

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  source CohortMemberSource @default(PURCHASE)

  /**
   * Provenance for PURCHASE seats (one seat per OrderItem).
   */
  orderItemId String?    @unique
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  /**
   * Live access (chat, sessions, announcements) ends here: the cohort end
   * date. Null = no expiry (staff-added). Evaluate by DATE, not only
   * status, exactly like Enrollment.expiresAt. Bundled CONTENT access
   * outlives this by the bonus (Enrollment COHORT_SEAT).
   */
  expiresAt DateTime?

  /**
   * Chat moderation. While in the future, the member can read but not
   * post. Audit every mute in AdminAuditLog.
   */
  chatMutedUntil DateTime?

  @@unique([cohortId, userId])
  @@index([userId, status])
  @@index([cohortId, status])
  @@index([status, expiresAt])
}

// ============================================================
// ANNOUNCEMENTS  (PHASE 2)
// ============================================================

enum AnnouncementAudience {
  ALL_STUDENTS
  TARGETED
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

model Announcement {
  id String @id @default(uuid())

  title String
  body  String @db.Text

  /**
   * ALL_STUDENTS: every ACTIVE StudentProfile, no target rows.
   * TARGETED: union of all AnnouncementTarget rows (cohorts and/or
   * courses). Course targets resolve to ACTIVE enrollments of ACTIVE
   * students only.
   */
  audience AnnouncementAudience @default(TARGETED)

  status AnnouncementStatus @default(DRAFT)

  sendEmail Boolean @default(true)
  isPinned  Boolean @default(false)

  scheduledFor DateTime?
  publishedAt  DateTime?

  /**
   * Set by the fan-out job when recipients are resolved.
   */
  recipientCount Int?
  lastError      String?

  createdById String
  createdBy   User   @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  targets AnnouncementTarget[]

  @@index([status, scheduledFor])
  @@index([status, publishedAt])
  @@index([deletedAt])
}

/**
 * Exactly ONE of cohortId / courseId must be set (DB CHECK in
 * manual_constraints.sql).
 */
model AnnouncementTarget {
  id String @id @default(uuid())

  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  cohortId String?
  cohort   Cohort? @relation(fields: [cohortId], references: [id], onDelete: Restrict)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([announcementId, cohortId])
  @@unique([announcementId, courseId])
  @@index([cohortId])
  @@index([courseId])
}

// ============================================================
// NOTIFICATIONS  (PHASE 2)
// ============================================================

enum NotificationType {
  STUDENT_REGISTERED
  ENROLLMENT_GRANTED
  ANNOUNCEMENT
  LIVE_SESSION_SCHEDULED
  LIVE_SESSION_UPDATED
  LIVE_SESSION_REMINDER
  LIVE_SESSION_CANCELLED
  SEAT_CONFIRMED
  ACCESS_ENDING_SOON
  SYSTEM
}

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType

  title String
  body  String? @db.Text

  /**
   * Loose pointer to the originating entity for deep links.
   * Intentionally not an FK: notifications must survive entity changes
   * and must not couple this table to every domain.
   */
  refType String?
  refId   String?

  /**
   * Deep-link / render payload. Keep small.
   */
  data Json?

  /**
   * Idempotency key for fan-out. Examples:
   * announcement:{announcementId}
   * live-reminder:{sessionId}:24h
   * live-reminder:{sessionId}:15m
   * Re-running a job must hit the unique constraint, not create dupes.
   */
  dedupeKey String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  deliveries NotificationDelivery[]

  /**
   * Add manually (see manual_constraints.sql): partial index on
   * (userId, createdAt DESC) WHERE readAt IS NULL for unread badges.
   * Retention: purge rows older than ~90 days via a scheduled job.
   */

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([refType, refId])
}

enum DeliveryChannel {
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

/**
 * Per-channel delivery tracking so email failure is never silent.
 * Resend/Nodemailer webhooks update this row via providerMessageId.
 */
model NotificationDelivery {
  id String @id @default(uuid())

  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  channel DeliveryChannel @default(EMAIL)
  status  DeliveryStatus  @default(PENDING)

  /**
   * Snapshot of the address used at send time.
   */
  toAddress String

  provider          String?
  providerMessageId String?

  attempts    Int       @default(0)
  lastError   String?
  sentAt      DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([notificationId, channel])
  @@index([status, createdAt])
  @@index([providerMessageId])
}

// ============================================================
// LIVE SESSIONS  (PHASE 3)
// ============================================================

enum LiveSessionProvider {
  ZOOM
  GOOGLE_MEET
  MICROSOFT_TEAMS
  JITSI
  /// In-app classroom (LiveKit). No joinUrl; students join with a token.
  LIVEKIT
  OTHER
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

/**
 * Provider-agnostic: the platform schedules, authorizes and reminds; the
 * video call itself runs on the external provider.
 * joinUrl / passcode are SECRETS: only returned by an endpoint that runs
 * the cohort access policy. Never include them in list payloads for
 * unauthorized users, logs, or notification bodies.
 */
model LiveSession {
  id String @id @default(uuid())

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  hostId String?
  host   User?   @relation("LiveSessionHost", fields: [hostId], references: [id], onDelete: SetNull)

  title       String
  description String?

  /**
   * Always stored UTC. Render in the viewer's timezone (default
   * Africa/Lagos).
   */
  startsAt DateTime
  endsAt   DateTime

  provider LiveSessionProvider @default(GOOGLE_MEET)
  /**
   * Required for every provider except LIVEKIT (DB CHECK).
   */
  joinUrl  String?
  passcode String?

  /**
   * Stage 2/3 safety net: shown to members if the in-app room cannot start.
   */
  fallbackJoinUrl String?

  /**
   * LIVEKIT only: unguessable room name.
   */
  roomName String? @unique

  /**
   * Which Zoom/Meet licence hosts this session. The DB forbids overlapping
   * sessions on one licence (EXCLUDE constraint in manual_constraints.sql).
   */
  meetingAccountId String?
  meetingAccount   MeetingAccount? @relation(fields: [meetingAccountId], references: [id], onDelete: SetNull)

  /**
   * Upcoming public-listing of open batches shows this session to Tier 1.
   */
  listedPublicly Boolean @default(true)

  status          LiveSessionStatus @default(SCHEDULED)
  cancelledReason String?

  /**
   * Link supplied by the provider (cloud recording). If recordings are
   * later hosted on Bunny with signed playback, ADD nullable columns
   * (recordingProvider, recordingAssetId); this does not break callers.
   */
  recordingUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * A session may serve several cohorts (joint classes).
   */
  cohorts    LiveSessionCohort[]
  recordings LiveSessionRecording[]

  @@index([status, startsAt])
  @@index([courseId])
  @@index([hostId])
  @@index([meetingAccountId, startsAt])
}

model LiveSessionCohort {
  id String @id @default(uuid())

  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([sessionId, cohortId])
  @@index([cohortId, sessionId])
}

// ============================================================
// LIVE-CLASS SEATS  (sold like courses; PHASE 1/2)
// ============================================================

/**
 * A purchasable seat in a cohort (batch). Several offers per cohort are
 * allowed (e.g. full price, or instalment plans later); they all share the
 * cohort's capacity. Paying creates a CohortMember and, when
 * includesCourseAccess, an Enrollment (source COHORT_SEAT) for each
 * CohortCourse that ends at cohort.endsAt + bonusDays.
 */
model CohortOffer {
  id String @id @default(uuid())

  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Restrict)

  name String

  price    Decimal @db.Decimal(10, 2)
  currency String  @default("NGN")

  includesCourseAccess Boolean @default(true)

  /**
   * Free extra CONTENT access after the batch ends. Snapshotted onto
   * OrderItem.bonusDays at order creation.
   */
  bonusDays Int @default(0)

  opensAt  DateTime?
  closesAt DateTime?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  carts      Cart[]
  applicants Applicant[]

  @@index([cohortId, isActive])
  @@index([isActive, closesAt])
}

// ============================================================
// MEETING LICENCES  (Stage 1: external Zoom / Meet)
// ============================================================

/**
 * One row per paid Zoom/Meet licence (the client has 2-3). A licence hosts
 * one meeting at a time, so the scheduler assigns a free one and the
 * database refuses overlaps.
 */
model MeetingAccount {
  id String @id @default(uuid())

  provider LiveSessionProvider
  label    String

  accountEmail String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())

  sessions LiveSession[]

  @@unique([provider, label])
}

// ============================================================
// RECORDINGS
// ============================================================

enum RecordingSource {
  ZOOM_IMPORT
  LIVEKIT_EGRESS
  MANUAL_UPLOAD
}

/**
 * A recorded live class, stored on Bunny (Stream) so playback is HLS with
 * signed URLs, like topic videos. Provider-independent, mirroring
 * VideoAsset. Access: staff, or a member of the session's cohort (ACTIVE or
 * COMPLETED) who ALSO has active access to the session's course. READY is
 * set only by the Bunny webhook.
 */
model LiveSessionRecording {
  id String @id @default(uuid())

  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  source RecordingSource

  /**
   * Zoom recording id / egress id. Makes imports idempotent.
   */
  sourceRef String?

  provider        VideoProvider @default(BUNNY)
  providerAssetId String?

  status VideoStatus @default(QUEUED)

  durationSeconds Int?
  fileSizeBytes   BigInt?
  thumbnailUrl    String?
  providerData    Json?

  retryCount Int     @default(0)
  lastError  String?

  readyAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([sessionId, sourceRef])
  @@unique([provider, providerAssetId])
  @@index([status])
}

// ============================================================
// CHAT  (PHASE 4)
// ============================================================

/**
 * Membership is DERIVED from the cohort (CohortMember, CohortInstructor).
 * There is deliberately no separate room-member table to keep in sync.
 * Multiple rooms per cohort are allowed (e.g. General, Q&A).
 */
model ChatRoom {
  id String @id @default(uuid())

  /**
   * EXACTLY ONE of cohortId / courseId (DB CHECK).
   * Cohort rooms: members = CohortMember (ACTIVE, not expired).
   * Course rooms: members = registered students (ACTIVE StudentProfile)
   * with an active Enrollment in the course.
   */
  cohortId String?
  cohort   Cohort? @relation(fields: [cohortId], references: [id], onDelete: Restrict)

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)

  name String @default("General")

  /**
   * TRUE: only staff can post (announcement-style room).
   */
  isReadOnly Boolean @default(false)
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages   ChatMessage[]
  readStates ChatReadState[]

  @@index([cohortId, isArchived])
  @@index([courseId, isArchived])
}

enum ChatMessageType {
  TEXT
  IMAGE
  SYSTEM
}

model ChatMessage {
  id String @id @default(uuid())

  roomId String
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)

  /**
   * Null for SYSTEM messages and when the author account is removed.
   */
  senderId String?
  sender   User?   @relation("ChatSender", fields: [senderId], references: [id], onDelete: SetNull)

  type ChatMessageType @default(TEXT)

  /**
   * Validate max length in Zod (e.g. 2000). Scrubbed to null when a
   * message is moderated away.
   */
  body String? @db.Text

  /**
   * [{ url, mimeType, sizeBytes, width, height }]
   * Files are uploaded to object storage/CDN out-of-band; the socket
   * only ever carries URLs.
   */
  attachments Json @default("[]")

  replyToId String?
  replyTo   ChatMessage?  @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("ChatReplies")

  /**
   * Client-generated id so a reconnect/retry cannot double-post.
   */
  clientMessageId String?

  editedAt DateTime?

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("ChatMessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([roomId, senderId, clientMessageId])
  @@index([roomId, createdAt, id])
  @@index([senderId])
}

/**
 * Unread count = messages in room with createdAt > lastReadAt.
 * Cache the count in Redis; this row is the source of truth.
 */
model ChatReadState {
  roomId String
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt DateTime
  updatedAt  DateTime @updatedAt

  @@id([roomId, userId])
  @@index([userId])
}

// ============================================================
// CURRICULUM DOMAIN
// ============================================================

/**
 * Program
 * ↓
 * ProgramCourse
 * ↓
 * Course
 * ↓
 * Module
 * ↓
 * Topic
 * ↓
 * VideoAsset
 * IMPORTANT:
 * Course MUST NOT have programId/program relation.
 * ProgramCourse is the only Program ↔ Course relationship.
 */

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Program {
  id          String  @id @default(uuid())
  title       String  @unique
  description String
  image       String?
  slug        String  @unique

  status ProgramStatus @default(DRAFT)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  courses ProgramCourse[]

  /**
   * FUTURE:
   * publishedAt / publishedById can be added when publishing workflow
   * becomes a first-class audited workflow. The current status field is
   * sufficient while publishing is simple.
   */

  @@index([slug])
  @@index([deletedAt])
  @@index([status, deletedAt])
}

model ProgramCourse {
  id String @id @default(uuid())

  programId String
  courseId  String

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  /**
   * FUTURE:
   * Add fields such as isRequired or curriculumLabel only if the
   * organization actually needs program-specific course behavior.
   * Keep that metadata here rather than polluting Course.
   */
  /**
   * ORDERING: position is intentionally NOT unique. A unique position
   * makes drag-reorder swaps fail mid-transaction. Reorder inside one
   * transaction and break ties by (position, id) when reading.
   */

  @@unique([programId, courseId])
  @@index([programId, position])
  @@index([courseId])
}

model Course {
  id String @id @default(uuid())

  title       String
  slug        String @unique
  code        String @unique
  description String

  thumbnail    String?
  videoPreview String?

  level CourseLevel @default(BEGINNER)
  tags  String[]

  status CourseStatus @default(DRAFT)

  /**
   * TRUE:
   * this organization issues its own certificate for course completion.
   * FALSE:
   * the course is tutoring / exam-preparation / external-certification
   * oriented and completion does not imply an organizational credential.
   */
  issuesCertificate Boolean @default(false)

  instructorId String?

  instructor User? @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: SetNull)

  /**
   * Denormalized aggregate:
   * SUM(Module.totalDurationSeconds)
   * Service-managed only.
   * Never accept arbitrary client values for this field.
   */
  totalDurationSeconds Int @default(0)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs    ProgramCourse[]
  pricings    CoursePricing[]
  enrollments Enrollment[]
  modules     Module[]

  // --- Student / community relations ---
  cohortCourses       CohortCourse[]
  announcementTargets AnnouncementTarget[]
  liveSessions        LiveSession[]

  /**
   * FUTURE:
   * If courses can have multiple instructors, replace instructorId with
   * CourseInstructor. Do this when the requirement appears rather than
   * carrying a join table unnecessarily today.
   * FUTURE:
   * If course analytics become heavy, add separate read-optimized
   * analytics/projection tables. Do not turn the Course row into an
   * analytics warehouse.
   */

  applicantPapers ApplicantPaper[]
  chatRooms       ChatRoom[]

  @@index([title])
  @@index([slug])
  @@index([code])
  @@index([instructorId])
  @@index([deletedAt])
  @@index([status, deletedAt])
  @@index([level])
}

// ============================================================
// COURSE PRICING / ACCESS OFFERS
// ============================================================

model CoursePricing {
  id       String @id @default(uuid())
  courseId String

  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  name String?

  price    Decimal @db.Decimal(10, 2)
  isFree   Boolean @default(false)
  currency String  @default("NGN")

  /**
   * CANONICAL ACCESS DURATION.
   * 7      = 7 days
   * 14     = 14 days
   * 30     = 30 days
   * 90     = 90 days
   * 365    = 1 year
   * null   = lifetime
   * DO NOT introduce a separate duration enum.
   * This must remain the single source of truth.
   */
  accessDurationDays Int?

  /**
   * Free extra access added on top of accessDurationDays at purchase
   * ("one month free"). 0 = none. Snapshotted onto OrderItem.bonusDays
   * when the order is created. Irrelevant for lifetime offers.
   */
  bonusDays Int @default(0)

  /**
   * Stable ordering for admin/storefront presentation.
   * Example:
   * 7 days      → 1
   * 14 days     → 2
   * 30 days     → 3
   * 90 days     → 4
   * Lifetime    → 5
   */
  sortOrder Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  carts       Cart[]
  enrollments Enrollment[]
  orderItems  OrderItem[]

  /**
   * IMPORTANT POSTGRESQL CONSTRAINTS
   * Prisma DSL currently does not express WHERE predicates for partial
   * unique indexes. Add these manually to the generated migration:
   * CREATE UNIQUE INDEX course_pricing_one_lifetime_per_course
   * ON "CoursePricing" ("courseId")
   * WHERE "accessDurationDays" IS NULL
   * AND "isActive" = true;
   * CREATE UNIQUE INDEX course_pricing_one_active_duration_per_course
   * ON "CoursePricing" ("courseId", "accessDurationDays")
   * WHERE "isActive" = true
   * AND "accessDurationDays" IS NOT NULL;
   * This gives:
   * - only one active lifetime offer per course
   * - only one active 7-day offer per course
   * - only one active 14-day offer per course
   * - etc.
   * - historical/inactive pricing can remain stored
   * FUTURE:
   * Add effectiveFrom/effectiveTo only when scheduled price changes are
   * actually needed. Do not make pricing temporal before the business
   * requires it.
   */

  @@index([courseId])
  @@index([courseId, isActive])
  @@index([courseId, accessDurationDays])
  @@index([courseId, sortOrder])
}

// ============================================================
// COURSE CURRICULUM
// ============================================================

model Module {
  id          String  @id @default(uuid())
  title       String
  description String?

  slug     String
  courseId String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  position Int @default(0)

  /**
   * Denormalized aggregate:
   * SUM(Topic.durationSeconds)
   * Only active/non-deleted topics should be included.
   * Service-managed only.
   */
  totalDurationSeconds Int @default(0)

  views       Int @default(0)
  completions Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  topics Topic[]

  /**
   * FUTURE:
   * Module analytics such as views/completions should eventually move
   * into event/analytics projections if traffic becomes significant.
   * Keeping small counters here is acceptable for the current product.
   */

  /**
   * SLUGS: on soft delete the service MUST suffix the slug (see Topic).
   */

  @@unique([courseId, slug])
  @@index([courseId, position])
  @@index([courseId, deletedAt])
}

model Topic {
  id String @id @default(uuid())

  title String
  slug  String

  moduleId String

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  position Int @default(0)

  /**
   * Authoritative curriculum duration cache.
   * For video topics:
   * VideoAsset.durationSeconds
   * ↓
   * Topic.durationSeconds
   * ↓
   * Module.totalDurationSeconds
   * ↓
   * Course.totalDurationSeconds
   * For non-video topics this can remain 0 unless the learning system
   * later supports explicit reading/activity durations.
   */
  durationSeconds Int @default(0)

  videoAsset VideoAsset?
  resources  TopicResource[]
  progress   Progress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  /**
   * FUTURE:
   * Add Topic.type when the product formally supports multiple learning
   * primitives such as ARTICLE, FILE, QUIZ, ASSIGNMENT, etc.
   * Do not add a type enum merely to prepare for hypothetical features.
   */
  /**
   * ORDERING: position is intentionally NOT unique (see ProgramCourse).
   * SLUGS: (moduleId, slug) stays unique so findUnique accessors keep
   * working. On soft delete the service MUST suffix the slug
   * (e.g. "intro-deleted-<shortId>") so deleted rows never reserve it.
   */

  @@unique([moduleId, slug])
  @@index([moduleId, deletedAt, position])
}

// ============================================================
// VIDEO / MEDIA
// ============================================================

enum VideoProvider {
  BUNNY
  AWS
  CLOUDFLARE
  MUX
}

enum VideoStatus {
  QUEUED
  PROCESSING
  UPLOADED
  READY
  FAILED
}

/**
 * Provider-independent media record.
 * Topic owns the relationship.
 * VideoAsset owns provider infrastructure.
 * Current rule:
 * One Topic → zero or one current VideoAsset.
 * Re-upload/retry updates the same VideoAsset rather than creating
 * multiple competing "current" assets.
 * FUTURE:
 * If media version history becomes a real requirement, introduce
 * VideoAssetVersion rather than destroying/replacing the historical row.
 */
model VideoAsset {
  id String @id @default(uuid())

  topicId String @unique

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  /**
   * Provider abstraction:
   * BUNNY      = default video delivery
   * AWS        = typically S3/CloudFront-based pipeline
   * CLOUDFLARE = Stream
   * MUX        = Mux Video
   */
  provider VideoProvider @default(BUNNY)

  /**
   * Provider-side primary identifier.
   * Examples:
   * Bunny      → video GUID
   * Cloudflare → Stream UID
   * Mux        → asset ID
   * AWS        → object key / media pipeline identifier
   * Provider-specific values beyond this identifier belong in
   * providerData.
   */
  providerAssetId String?

  status VideoStatus @default(QUEUED)

  /**
   * Media metadata returned by the provider/processing pipeline.
   */
  durationSeconds Int?
  thumbnailUrl    String?

  fileSizeBytes BigInt?
  width         Int?
  height        Int?

  /**
   * Provider-specific metadata that does not justify first-class
   * columns in the domain.
   * Examples:
   * {
   * "bucket": "...",
   * "region": "...",
   * "playbackIds": [...],
   * "libraryId": "...",
   * "streamUid": "..."
   * }
   */
  providerData Json?

  retryCount Int @default(0)

  lastError String?

  /**
   * Used to make uploads/creation requests idempotent.
   */
  idempotencyKey String? @unique

  /**
   * Set when the media asset becomes actually playable/ready.
   * This is intentionally not called uploadedAt because upload and
   * readiness are different lifecycle events.
   */
  readyAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * IMPORTANT:
   * Do NOT persist a long-lived playbackUrl here.
   * Playback URLs may be:
   * - signed
   * - temporary
   * - provider-specific
   * - generated differently per request/user
   * The media service should resolve playback dynamically from:
   * provider + providerAssetId + providerData
   * FUTURE:
   * If you need multiple renditions/playback profiles, introduce a
   * provider-specific playback service rather than adding columns such as
   * hlsUrl, dashUrl, signedUrl, etc. to this table.
   */

  @@unique([provider, providerAssetId])
  @@index([status])
  @@index([provider])
  @@index([providerAssetId])
}

// ============================================================
// TOPIC RESOURCES
// ============================================================

enum ResourceType {
  PDF
  EXCEL
  WORD
  TEMPLATE
  LINK
}

// enum ResourceType {
//   FILE
//   LINK
// }

enum ResourceStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

model TopicResource {
  id String @id @default(uuid())

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  type  ResourceType
  title String

  storageKey String?
  url        String?

  mimeType  String?
  sizeBytes Int?

  status     ResourceStatus @default(QUEUED)
  retryCount Int            @default(0)
  lastError  String?
  readyAt    DateTime?

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topicId, position])
  @@index([status])
}

// ============================================================
// LEARNING ACCESS
// ============================================================

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

/**
 * How the enrollment was CREATED (rule 15). Later renewals/extensions
 * do not change this value; they are audited in AdminAuditLog.
 */
enum EnrollmentSource {
  PURCHASE
  ADMIN_GRANT
  /// Bundled content from a paid cohort seat; ends at cohort end + bonus.
  COHORT_SEAT
}

model Enrollment {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  /**
   * NULL for ADMIN_GRANT enrollments (no commercial offer was bought).
   * REQUIRED when source = PURCHASE (DB CHECK in manual_constraints.sql).
   */
  pricingId String?

  pricing CoursePricing? @relation(fields: [pricingId], references: [id], onDelete: Restrict)

  /**
   * Creation channel. Existing rows backfill to PURCHASE.
   */
  source EnrollmentSource @default(PURCHASE)

  /**
   * Provenance for ADMIN_GRANT: who granted it and why.
   * NULL for PURCHASE.
   */
  grantedById String?
  grantedBy   User?   @relation("EnrollmentGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  grantReason String?

  /**
   * Set only for source = COHORT_SEAT: the cohort whose paid seat bundled
   * this course. Such rows have no pricingId and no orderItemId (the
   * seat's OrderItem is recorded on CohortMember.orderItemId).
   */
  cohortId String?
  cohort   Cohort? @relation("CohortSeatEnrollments", fields: [cohortId], references: [id], onDelete: Restrict)

  /**
   * Provenance:
   * The OrderItem that originally created this enrollment.
   * NULL for ADMIN_GRANT. Unique still guarantees one enrollment per
   * OrderItem (Postgres allows many NULLs under a unique index).
   * Renewals do NOT create a second Enrollment.
   * They update this same row.
   * Full purchase history lives in Order/OrderItem/Payment.
   */
  orderItemId String? @unique

  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  orderId String?

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /**
   * Access state ONLY.
   * Payment state belongs to Order/Payment.
   */
  status EnrollmentStatus @default(ACTIVE)

  startedAt DateTime @default(now())

  /**
   * NULL = lifetime access.
   * For temporary access:
   * expiresAt = access end
   * Access should be evaluated using:
   * status
   * + startedAt
   * + expiresAt
   */
  expiresAt DateTime?

  /**
   * IMPORTANT:
   * No isLifetime column.
   * Lifetime is represented by:
   * expiresAt = NULL
   * This avoids having:
   * isLifetime = true
   * expiresAt = a date
   * which would create contradictory states.
   */

  completedAt DateTime?

  /**
   * Denormalized progress read model.
   * Progress records remain authoritative.
   * This value is maintained by progress services.
   */
  progressPercentage Float @default(0)

  certificate     Certificate?
  progressRecords Progress[]

  /**
   * FUTURE:
   * If access becomes more complex (scholarships, grants, admin overrides,
   * promotional periods, multiple purchases, pause/resume, etc.), introduce:
   * EnrollmentAccessGrant
   * and keep Enrollment as the current effective access projection.
   * Do NOT introduce that model until the business genuinely requires
   * multiple independent access grants.
   * Migration path is additive: backfill one grant per existing
   * enrollment, then compute expiresAt from grants.
   */

  /**
   * One current access record per learner/course.
   * Renewals:
   * UPDATE this row.
   * Tier upgrades:
   * UPDATE this row.
   * Admin extensions:
   * UPDATE this row + write AdminAuditLog (before/after expiresAt).
   * This preserves a single progress history for the learner/course.
   */
  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([orderId])
  @@index([source])
  @@index([grantedById])
  @@index([cohortId])
}

// ============================================================
// LEARNING PROGRESS
// ============================================================

model Progress {
  id String @id @default(uuid())

  enrollmentId String
  topicId      String

  completed Boolean @default(false)

  /**
   * Watched time is useful as a derived display metric.
   * watchedRanges is the authoritative representation of coverage.
   */
  watchedSeconds Int? @default(0)

  /**
   * Example:
   * [[0,120],[150,420]]
   * Intervals should be merged by the service layer.
   */
  watchedRanges Json? @default("[]")

  lastWatchedAt DateTime?

  /**
   * Optional cached topic duration at the time progress was recorded.
   * Service logic should prefer Topic.durationSeconds when recalculating
   * current course progress.
   */
  duration Int?

  updatedAt DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  /**
   * FUTURE:
   * If you need detailed learner activity analytics, do not keep appending
   * raw events into Progress. Add an append-only learning event model or
   * external analytics pipeline.
   */

  @@unique([enrollmentId, topicId])
}

// ============================================================
// CART
// ============================================================

model Cart {
  id String @id @default(uuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * EXACTLY ONE of pricingId / cohortOfferId (DB CHECK).
   */
  pricingId String?

  pricing CoursePricing? @relation(fields: [pricingId], references: [id], onDelete: Cascade)

  cohortOfferId String?

  cohortOffer CohortOffer? @relation(fields: [cohortOfferId], references: [id], onDelete: Cascade)

  /**
   * Course is derivable through CoursePricing.
   * Deliberately NOT stored here as a second FK because:
   * Cart.courseId != CoursePricing.courseId
   * would create invalid contradictory state.
   * If you need the Course:
   * cart.pricing.course
   */

  quantity Int @default(1)

  /**
   * Checkout snapshot.
   * The cart price should be treated as the current selected offer price
   * when the cart is created/updated.
   * OrderItem is the final immutable purchase snapshot.
   */
  price Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  /**
   * FUTURE:
   * If guest carts become a requirement, support a secure anonymous cart
   * token rather than making userId nullable without a defined ownership
   * model.
   */

  @@unique([userId, pricingId])
  @@unique([userId, cohortOfferId])
}

// ============================================================
// ORDERS / COMMERCE
// ============================================================

model Order {
  id String @id @default(uuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  idempotencyKey String?

  /**
   * Contact snapshot at purchase time. There is NO guest checkout: a
   * user must be signed in before paying, so userId is always set.
   * These remain even if the user later changes their profile.
   */
  email String?
  name  String?
  phone String?

  totalAmount Decimal @db.Decimal(10, 2)

  /**
   * Derived business convenience field for UI/reporting.
   * A zero-value order is still represented explicitly as a free order.
   */
  isFreeOrder Boolean @default(false)

  currency String @default("NGN")

  status PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expiresAt DateTime?

  enrollments Enrollment[]
  items       OrderItem[]
  payments    Payment[]

  /**
   * FUTURE — HIGH PRIORITY WHEN CHECKOUT MATURES:
   * Separate payment state from order lifecycle:
   * OrderStatus:
   * PENDING
   * PAID
   * CANCELLED
   * REFUNDED
   * OrderFulfillmentStatus:
   * PENDING
   * PROCESSING
   * FULFILLED
   * FAILED
   * This is preferable once order fulfillment becomes more complex than
   * the current single-course/simple-checkout flow.
   * Do not mix gateway payment state and order lifecycle forever.
   */

  @@index([userId])
  @@index([email])
  @@index([isFreeOrder])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id String @id @default(uuid())

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /**
   * EXACTLY ONE of pricingId (course offer) / cohortOfferId (live-class
   * seat) is set (DB CHECK in manual_constraints.sql).
   */
  pricingId String?

  pricing CoursePricing? @relation(fields: [pricingId], references: [id], onDelete: Restrict)

  cohortOfferId String?

  cohortOffer CohortOffer? @relation(fields: [cohortOfferId], references: [id], onDelete: Restrict)

  /**
   * Snapshot of the free bonus promised at order creation. Fulfillment
   * uses THIS, not the live offer, so editing an offer between checkout
   * and payment cannot change what the customer was promised.
   */
  bonusDays Int @default(0)

  /**
   * Immutable commercial snapshot.
   * These values represent what the customer purchased, not what the
   * pricing record says today.
   */
  unitPrice Decimal @db.Decimal(10, 2)

  quantity Int @default(1)

  createdAt DateTime @default(now())

  enrollment   Enrollment?
  cohortMember CohortMember?

  /**
   * FUTURE — RECOMMENDED BEFORE SERIOUS ORDER HISTORY REPORTING:
   * Add immutable snapshot fields such as:
   * productName
   * pricingName
   * courseTitle
   * courseSlug
   * accessDurationDays
   * currency
   * This ensures historical orders remain human-readable even if the
   * current Course/CoursePricing records are renamed or removed.
   */

  @@index([orderId])
  @@index([pricingId])
  @@index([cohortOfferId])
}

// ============================================================
// CERTIFICATES
// ============================================================

model Certificate {
  id String @id @default(uuid())

  enrollmentId String @unique

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  issuedAt DateTime @default(now())

  url String

  verification String @unique

  /**
   * Historical snapshot.
   * The course title may change after issuance.
   */
  courseTitleAtIssuance String

  /**
   * FUTURE:
   * Add learnerNameAtIssuance and certificateNumber before production
   * certificate issuance becomes legally/operationally important.
   * Also add revokedAt/revocationReason rather than deleting certificates.
   */
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id String @id @default(uuid())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  /**
   * Internal/gateway transaction reference generated for the payment.
   */
  reference String @unique

  /**
   * Last gateway event/webhook ID seen for this payment. Informational
   * only. NOT unique: one payment receives several events (charge.success,
   * refund.*, retries). Webhook idempotency lives in PaymentEvent
   * (gateway, eventId).
   */
  gatewayEventId String?

  /**
   * Payment belongs to an ORDER, not an ENROLLMENT.
   * One payment may cover multiple OrderItems and therefore multiple
   * course enrollments.
   */
  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  amount   Decimal        @db.Decimal(10, 2)
  currency String         @default("NGN")
  status   PaymentStatus  @default(PENDING)
  gateway  PaymentGateway

  /**
   * Raw gateway payload retained for reconciliation/debugging.
   * Never expose directly through normal learner APIs.
   */
  rawPayload Json?
  metadata   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events PaymentEvent[]

  @@index([reference])
  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([gateway, status, createdAt])
}

/**
 * One row per gateway webhook delivery. Append-only audit trail.
 * Flow: verify signature -> INSERT (gateway, eventId) -> on unique
 * violation, ack 200 and stop (duplicate) -> process -> set processedAt
 * or processingError. A row with processedAt NULL is retryable work,
 * never a silent failure.
 */
model PaymentEvent {
  id String @id @default(uuid())

  gateway PaymentGateway

  /**
   * Gateway-provided event id; when a gateway sends none, derive a
   * stable hash of (event type + reference).
   */
  eventId   String
  eventType String

  /**
   * Resolved after parsing. Null when the event arrives for an unknown
   * reference (still stored for reconciliation).
   */
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  reference String?

  signatureValid Boolean @default(false)

  rawPayload Json

  processedAt     DateTime?
  processingError String?
  attempts        Int       @default(0)

  receivedAt DateTime @default(now())

  @@unique([gateway, eventId])
  @@index([paymentId])
  @@index([reference])
  @@index([processedAt, receivedAt])
}

// ============================================================
// ENUMS
// ============================================================

enum PaymentGateway {
  PAYSTACK
  FLUTTERWAVE
  STRIPE
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/**
 * Role is the ACCOUNT type, not the registered-student flag.
 * `student` = any learner account (public buyer OR registered student).
 * Registered-student status lives on StudentProfile (rule 12).
 */
enum Role {
  student
  instructor
  admin
  superadmin
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}
