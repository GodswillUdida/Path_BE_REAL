// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //binaryTargets = ["native", "debian-openssl-3.0.x"]
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url        = env("DATABASE_URL")
  // directUrl  = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String?
  email        String   @unique
  profileImage String?
  phone        String?
  role         Role     @default(student)

  emailVerified       Boolean   @default(false)
  verificationToken   String?   @unique
  verificationExpires DateTime?

  resetToken        String?   @unique
  resetTokenExpires DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  accounts    Account[]
  sessions    Session[]
  courses     Course[]     @relation("InstructorCourses")
  enrollments Enrollment[]
  payments    Payment[]
  carts       Cart[]
  orders      Order[]

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model Account {
  id          String   @id @default(uuid())
  userId      String
  provider    String   // "google", "credentials"
  providerId  String   // googleId or email for credentials
  password    String?  // only for credentials

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("accounts")
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  code      String   // 6-digit
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([email, code])
  @@index([email, expiresAt])
}

model MagicLoginToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([email])
}

//////////////////////////////////////////////////////
// SESSION (Refresh Token + Device Tracking)
//////////////////////////////////////////////////////

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenId   String @unique // from JWT payload
  tokenHash String @unique // hashed refresh token

  userAgent   String?
  ipAddress   String?
  fingerprint String?

  expiresAt DateTime
  revokedAt DateTime?

  provider String   @default("credentials") // "credentials" or "google"

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}


model Program {
  id          String   @id @default(uuid())
  title       String   @unique
  description String
  image       String?
  slug        String   @unique
  courses     Course[]
  // enrollments Enrollment[]

  status CourseStatus @default(DRAFT)

  price    Float?
  currency String @default("NGN")

  deletedAt DateTime?
  // pricings    CoursePricing[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([slug])
  @@index([deletedAt])
}

model Course {
  id           String  @id @default(uuid())
  title        String
  slug         String  @unique
  description  String
  thumbnail    String?
  videoPreview String?

  level String?
  tags  String[]

  duration Int?
  status   CourseStatus @default(DRAFT)

  // category           String?
  // schedule           String?

  instructor   User?   @relation("InstructorCourses", fields: [instructorId], references: [id])
  instructorId String?

  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  programId String?

  pricings    CoursePricing[]
  enrollments Enrollment[]
  modules     Module[]

  carts     Cart[]
  deletedAt DateTime?

  // enrollmentRequests EnrollmentRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([programId])
  @@index([deletedAt])
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model CoursePricing {
  id       String @id @default(uuid())
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  name     String? // e.g. "1 Day Access"
  price    Float
  currency String  @default("NGN")

  durationDays Int

  // programId   String?
  // program     Program?     @relation(fields: [programId], references: [id])

  // enrollments Enrollment[]

  isActive Boolean @default(true)

  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
  carts       Cart[]
  orderItems  OrderItem[]

  @@unique([courseId, durationDays])
  @@index([courseId])
}

/////////////////////////
// MODULES & TOPICS
/////////////////////////

model Module {
  id          String  @id @default(uuid())
  title       String
  description String?
  slug        String  @unique @default("")

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  position Int @default(0)

  topics Topic[]

  views       Int @default(0)
  completions Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([courseId, position])
}

model Topic {
  id    String @id @default(uuid())
  title String
  slug  String @unique

  bunnyVideoId    String? @unique
  videoStatus     String? // created | uploaded | processing | ready | failed
  durationSeconds Int?
  thumbnailUrl    String?
  fileSizeBytes   Int?
  videoWidth      Int?
  videoHeight     Int?

  resources Json?

  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId String

  progress Progress[]

  position Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([bunnyVideoId, moduleId, position])
}

model Enrollment {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  pricing   CoursePricing @relation(fields: [pricingId], references: [id])
  pricingId String

  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  // programId     String?
  // program       Program?      @relation(fields: [programId], references: [id])

  // progress      Progress[]

  paymentStatus PaymentStatus @default(PENDING)
  paymentRef    String?

  startedAt DateTime @default(now())
  expiresAt DateTime

  completedAt DateTime?

  progressPercentage Float @default(0)

  progressRecords Progress[]

  certificate Certificate?
  payments    Payment[]

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  @@unique([userId, courseId, pricingId])
  @@index([userId, courseId])
  @@index([expiresAt])
}

model Progress {
  id String @id @default(uuid())

  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId String

  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId String

  completed      Boolean @default(false)
  watchedSeconds Int?    @default(0)

  lastWatchedAt DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([enrollmentId, topicId])
}

model Cart {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pricingId String
  pricing   CoursePricing @relation(fields: [pricingId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  // courseId  String
  // course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  price     Float
  createdAt DateTime @default(now())
  course    Course?  @relation(fields: [courseId], references: [id])
  courseId  String?

  @@unique([userId, pricingId])
}

model Order {
  id String @id @default(uuid())

  // optional logged-in user
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // guest checkout identity
  email String
  name  String?
  phone String?

  totalAmount Float
  currency    String        @default("NGN")
  status      PaymentStatus @default(PENDING)

  items       OrderItem[]
  payments    Payment[]
  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([email])
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  pricingId String
  pricing   CoursePricing @relation(fields: [pricingId], references: [id])

  unitPrice Float
  quantity  Int   @default(1)

  enrollment Enrollment?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([pricingId])
}

model Certificate {
  id                    String     @id @default(uuid())
  enrollment            Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId          String     @unique
  issuedAt              DateTime   @default(now())
  url                   String
  verification          String     @unique
  courseTitleAtIssuance String
}

model Payment {
  id     String @id @default(uuid())
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  reference String @unique

  enrollmentId String?
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id])

  orderId String
  order   Order? @relation(fields: [orderId], references: [id])

  amount   Float
  currency String @default("NGN")

  status   PaymentStatus @default(PENDING)
  gateway  String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([orderId])
}

enum Role {
  student
  instructor
  admin
  superadmin
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RequestStatus {
  PENDING
  CONTACTED
  REGISTERED
  REJECTED
}
