generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String       @id @default(uuid())
  name                String?
  email               String       @unique
  profileImage        String?
  phone               String?
  role                Role         @default(student)
  emailVerified       Boolean      @default(false)
  verificationToken   String?      @unique
  verificationExpires DateTime?
  resetToken          String?      @unique
  resetTokenExpires   DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?
  carts               Cart[]
  courses             Course[]     @relation("InstructorCourses")
  enrollments         Enrollment[]
  orders              Order[]
  payments            Payment[]
  accounts            Account[]
  sessions            Session[]

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model Account {
  id         String   @id @default(uuid())
  userId     String
  provider   String
  providerId String
  password   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("accounts")
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([email, code])
  @@index([email, expiresAt])
}

model MagicLoginToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  tokenId     String    @unique
  tokenHash   String    @unique
  userAgent   String?
  ipAddress   String?
  fingerprint String?
  expiresAt   DateTime
  revokedAt   DateTime?
  provider    String    @default("credentials")
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model IdempotencyKey {
  id          String   @id @default(uuid())
  key         String
  scope       String
  response    Json?
  statusCode  Int?
  createdAt   DateTime @default(now())

  @@unique([key, scope])
}

model Program {
  id          String       @id @default(uuid())
  title       String       @unique
  description String
  image       String?
  slug        String       @unique
  status      CourseStatus @default(DRAFT)
  price       Float?
  currency    String       @default("NGN")
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  courses     Course[]

  @@index([slug])
  @@index([deletedAt])
}

model Course {
  id           String          @id @default(uuid())
  title        String
  slug         String          @unique
  description  String
  thumbnail    String?
  videoPreview String?
  level        String?
  tags         String[]
  duration     Int?
  status       CourseStatus    @default(DRAFT)
  instructorId String?
  programId    String?
  deletedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  carts        Cart[]
  instructor   User?           @relation("InstructorCourses", fields: [instructorId], references: [id])
  program      Program?        @relation(fields: [programId], references: [id])
  pricings     CoursePricing[]
  enrollments  Enrollment[]
  modules      Module[]

  @@index([slug])
  @@index([programId])
  @@index([deletedAt])
}

model CoursePricing {
  id           String       @id @default(uuid())
  courseId     String
  name         String?
  price        Float
  currency     String       @default("NGN")
  durationDays Int
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  carts        Cart[]
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  orderItems   OrderItem[]

  @@unique([courseId, durationDays])
  @@index([courseId])
}

model Module {
  id          String    @id @default(uuid())
  title       String
  description String?
  slug        String    @unique @default("")
  courseId    String
  position    Int       @default(0)
  views       Int       @default(0)
  completions Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  deletedAt   DateTime?
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topics      Topic[]

  @@index([courseId, position])
}

model Topic {
  id              String     @id @default(uuid())
  title           String
  slug            String     @unique
  bunnyVideoId    String?    @unique
  videoStatus     String?
  durationSeconds Int?
  thumbnailUrl    String?
  fileSizeBytes   Int?
  videoWidth      Int?
  videoHeight     Int?
  resources       Json?
  idempotencyKey  String?    @unique
  moduleId        String
  position        Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
  progress        Progress[]
  module          Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([bunnyVideoId, moduleId, position])
}

model Enrollment {
  id                 String        @id @default(uuid())
  userId             String
  courseId           String
  pricingId          String
  orderItemId        String        @unique
  paymentStatus      PaymentStatus @default(PENDING)
  paymentRef         String?
  startedAt          DateTime      @default(now())
  expiresAt          DateTime
  completedAt        DateTime?
  progressPercentage Float         @default(0)
  orderId            String?
  certificate        Certificate?
  course             Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order              Order?        @relation(fields: [orderId], references: [id])
  orderItem          OrderItem     @relation(fields: [orderItemId], references: [id])
  pricing            CoursePricing @relation(fields: [pricingId], references: [id])
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments           Payment[]
  progressRecords    Progress[]

  @@unique([userId, courseId, pricingId])
  @@index([userId, courseId])
  @@index([expiresAt])
}

model Progress {
  id             String     @id @default(uuid())
  enrollmentId   String
  topicId        String
  completed      Boolean    @default(false)
  watchedSeconds Int?       @default(0)
  lastWatchedAt  DateTime?
  updatedAt      DateTime   @updatedAt
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  topic          Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, topicId])
}

model Cart {
  id        String        @id @default(uuid())
  userId    String
  pricingId String
  quantity  Int           @default(1)
  price     Float
  createdAt DateTime      @default(now())
  courseId  String?
  course    Course?       @relation(fields: [courseId], references: [id])
  pricing   CoursePricing @relation(fields: [pricingId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pricingId])
}

model Order {
  id          String        @id @default(uuid())
  userId      String?
  email       String
  name        String?
  phone       String?
  totalAmount Float
  currency    String        @default("NGN")
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  enrollments Enrollment[]
  user        User?         @relation(fields: [userId], references: [id])
  items       OrderItem[]
  payments    Payment[]

  @@index([userId])
  @@index([email])
}

model OrderItem {
  id         String        @id @default(uuid())
  orderId    String
  pricingId  String
  unitPrice  Float
  quantity   Int           @default(1)
  createdAt  DateTime      @default(now())
  enrollment Enrollment?
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pricing    CoursePricing @relation(fields: [pricingId], references: [id])

  @@index([orderId])
  @@index([pricingId])
}

model Certificate {
  id                    String     @id @default(uuid())
  enrollmentId          String     @unique
  issuedAt              DateTime   @default(now())
  url                   String
  verification          String     @unique
  courseTitleAtIssuance String
  enrollment            Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

model Payment {
  id           String        @id @default(uuid())
  userId       String?
  reference    String        @unique
  enrollmentId String?
  orderId      String
  amount       Float
  currency     String        @default("NGN")
  status       PaymentStatus @default(PENDING)
  gateway      String
  metadata     Json?
  createdAt    DateTime      @default(now())
  enrollment   Enrollment?   @relation(fields: [enrollmentId], references: [id])
  order        Order         @relation(fields: [orderId], references: [id])
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Role {
  student
  instructor
  admin
  superadmin
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RequestStatus {
  PENDING
  CONTACTED
  REGISTERED
  REJECTED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseCategory {
  ACCOUNTING
  MARKETING
  PROGRAMMING
  DESIGN
  BUSINESS
}

enum CoursePricingDuration {
  ONE_DAY
  SEVEN_DAYS
  THIRTY_DAYS
  SIXTY_DAYS
  NINETY_DAYS
  ONE_YEAR
  LIFETIME
}
